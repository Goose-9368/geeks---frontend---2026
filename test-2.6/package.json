{
  "name": "geeks-control-work-2",
  "private": true,
  "version": "1.0.0",
  "description": "Geeks month 6: TypeScript, Swagger, Tailwind, FSD and Storybook",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ./swagger.json -o ./api.d.ts",
    "check:api": "openapi-typescript ./swagger.json -o ./api.d.ts --check",
    "check": "npm run typecheck && npm run check:api",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "openapi-typescript": "^7.10.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
